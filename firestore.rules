rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default open read/write for SIPERBAWA collections
    match /laporan_budidaya/{laporanId} {
      allow read, write: if true;
    }

    match /users_account/{userId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /system_metadata/{metaId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

